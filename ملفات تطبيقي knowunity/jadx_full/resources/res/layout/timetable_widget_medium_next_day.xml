<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:background="@drawable/timetable_widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToOutline="true">
    <include layout="@layout/timetable_widget_date_column"/>
    <LinearLayout
        android:layout_gravity="end"
        android:orientation="vertical"
        android:layout_width="144dp"
        android:layout_height="match_parent"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="12dp">
        <TextView
            android:textColor="@color/timetable_widget_text_secondary"
            android:ellipsize="end"
            android:gravity="start|center_vertical"
            android:id="@+id/medium_header"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:maxLines="1"
            style="@style/TimetableWidgetText.CaptionM"/>
        <ListView
            android:id="@+id/medium_list"
            android:paddingBottom="10dp"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="8dp"
            android:divider="@android:color/transparent"
            android:dividerHeight="4dp"/>
    </LinearLayout>
    <include layout="@layout/timetable_widget_medium_message"/>
</FrameLayout>
