<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="28dp"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:layout_marginStart="16dp">
    <TextView
        android:textColor="@color/timetable_widget_text_secondary"
        android:gravity="center"
        android:id="@+id/date_weekday"
        android:layout_width="match_parent"
        android:layout_height="16dp"
        android:maxLines="1"
        style="@style/TimetableWidgetText.CaptionM"/>
    <TextView
        android:textColor="@color/timetable_widget_text_primary"
        android:gravity="center"
        android:id="@+id/date_day"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:maxLines="1"
        style="@style/TimetableWidgetText.HeadlineM"/>
</LinearLayout>
