<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/row_root"
    android:paddingBottom="4dp"
    android:layout_width="match_parent"
    android:layout_height="36dp">
    <TextView
        android:textColor="@color/timetable_widget_text_primary"
        android:gravity="start|center_vertical"
        android:id="@+id/row_start"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_marginEnd="4dp"
        style="@style/TimetableWidgetText.CaptionM"/>
    <FrameLayout
        android:id="@+id/row_card"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
        <ImageView
            android:id="@+id/row_fill"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/timetable_widget_pill_fill"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <ImageView
            android:id="@+id/row_outline"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/timetable_widget_free_period_outline"
            android:scaleType="fitXY"
            android:contentDescription="@null"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">
            <include layout="@layout/timetable_widget_row_title"/>
            <TextView
                android:ellipsize="end"
                android:gravity="end"
                android:id="@+id/row_trailing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                style="@style/TimetableWidgetText.CaptionM"/>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
