<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/quick_actions_background"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/quick_actions_content"
        android:padding="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:id="@+id/quick_actions_chat"
            android:background="@drawable/quick_actions_control"
            android:focusable="true"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7"
            android:contentDescription="@string/quick_actions_chat"
            android:clipToOutline="true">
            <TextView
                android:textSize="18sp"
                android:textColor="@color/quick_actions_label"
                android:gravity="center_vertical"
                android:id="@+id/quick_actions_chat_label"
                android:layout_width="64dp"
                android:layout_height="match_parent"
                android:text="@string/quick_actions_chat"
                android:maxLines="1"
                android:includeFontPadding="false"
                android:importantForAccessibility="no"
                android:fontFamily="sans-serif-medium"
                android:layout_marginStart="14dp"/>
            <ImageView
                android:layout_gravity="end|top"
                android:id="@+id/quick_actions_knowie"
                android:layout_width="62.13dp"
                android:layout_height="59.46dp"
                android:layout_marginTop="11.54dp"
                android:src="@drawable/quick_actions_knowie"
                android:importantForAccessibility="no"
                android:layout_marginEnd="-6.84dp"/>
            <ImageView
                android:id="@+id/quick_actions_chat_artwork"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                android:importantForAccessibility="no"/>
        </FrameLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:importantForAccessibility="no"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="7">
            <ImageView
                android:id="@+id/quick_actions_camera"
                android:background="@drawable/quick_actions_control"
                android:padding="14dp"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/quick_actions_camera"
                android:layout_weight="7"
                android:contentDescription="@string/quick_actions_camera"/>
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:importantForAccessibility="no"/>
            <ImageView
                android:id="@+id/quick_actions_voice"
                android:background="@drawable/quick_actions_control"
                android:padding="14dp"
                android:focusable="true"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:src="@drawable/quick_actions_voice"
                android:layout_weight="7"
                android:contentDescription="@string/quick_actions_voice"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
